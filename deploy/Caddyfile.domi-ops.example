# Domi Ops public launch — marketing apex + app + demo subdomains.
# Join Caddy to the compose proxy network (see docker-compose.proxy-external.yml).
#
#   docker compose -f docker-compose.prod.yml -f docker-compose.marketing.yml \
#     -f docker-compose.proxy-external.yml up -d --build

domi-ops.com {
    encode gzip zstd
    reverse_proxy domiops-www:3000
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

app.domi-ops.com {
    encode gzip zstd

    handle_path /s3/* {
        reverse_proxy minio:9000
    }

    # API liveness check lives at /api/healthz (apps/api/src/routes/health.ts), covered by
    # web's own /api/:path* → API_URL rewrite (apps/web/next.config.ts) — no special Caddy
    # rule needed. A prior version of this file special-cased a bare `/health` here to work
    # around web's auth middleware 302ing an unauthenticated liveness check to /login; that
    # bare path collided with the app's own /health page (the Health module) and silently
    # shadowed it for every household. Fixed 2026-08-30 by moving the liveness route under
    # /api instead of carving out a Caddy exception for it.
    reverse_proxy domiops-web:3000
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

demo.domi-ops.com {
    encode gzip zstd

    handle_path /s3/* {
        reverse_proxy minio:9000
    }

    reverse_proxy domiops-demo-web:3000
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}
