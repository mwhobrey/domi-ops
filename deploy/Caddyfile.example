# Replace homehub upstream with whome web container.
# Assumes docker compose joins external network "proxy" (see compose.prod.yml).

{$WHOME_DOMAIN} {
    encode gzip zstd

    reverse_proxy web:3000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# Optional: direct API subdomain (usually not needed — Next rewrites /api to api:4000)
# api.{$WHOME_DOMAIN} {
#     reverse_proxy api:4000
# }
