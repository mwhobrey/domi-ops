# Replace homehub upstream with whome web container.
# Prod compose includes postgres, redis, minio, api, worker, web.
# Join Caddy's Docker network via docker-compose.proxy-external.yml:
#
#   PROXY_NETWORK=headscale_default docker compose \
#     -f docker-compose.prod.yml -f docker-compose.proxy-external.yml up -d --build
#
# whobrey.me droplet: confirm network with `docker network ls`

whome.whobrey.me {
    encode gzip zstd
    reverse_proxy whome-web:3000
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# Generic template (set WHOME_DOMAIN env when using caddy adapt):
{$WHOME_DOMAIN} {
    encode gzip zstd

    reverse_proxy web:3000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

# Optional: direct API subdomain (usually not needed — Next rewrites /api to api:4000)
# api.{$WHOME_DOMAIN} {
#     reverse_proxy api:4000
# }
