{
  "baseline": "02cee513b42757f23a7feb3807769b3505b00ec4",
  "node": "v22.23.2",
  "checks": [
    "Better Auth 1.7.10 + OAuth provider 1.7.10 + existing username/JWT composition initializes",
    "Existing custom auth model names support synthetic signup and browser session",
    "Discovery excludes machine client-credentials grants",
    "Adding JWT support does not expose the generic browser-session /token endpoint",
    "Deployment-local issuer discovery exposes S256 and exact auth endpoint routing",
    "Wrong PKCE verifier rejected",
    "Authorization code with S256 issues resource-bound access and refresh tokens",
    "Resource helper verifies JWT and rejects wrong audience, issuer, scope and expiry",
    "Official SDK v2 client discovers and calls authenticated stateless Hono tool over HTTP",
    "MCP endpoint denies requests without a bearer token",
    "Refresh rotates tokens and makes the consumed refresh token inactive",
    "Revocation endpoint invalidates the current refresh token",
    "Revoked refresh token cannot mint another access token",
    "Provider consent reference binds immutable application grant claim across refresh",
    "Stateless JWT verification still accepts a signature-valid token after refresh revocation; live grant checks are required",
    "Public client PKCE flow issues tokens without a client secret",
    "PostgreSQL Drizzle adapter completes OAuth lifecycle with UUID IDs and custom auth model names",
    "Restricted-role two-household RLS fixture denies missing/wrong context, cross-household update and pooled context leakage"
  ],
  "limits": [
    "Synthetic PostgreSQL tables generated from provider schema; not production migrations, app domain routes or live-client acceptance."
  ],
