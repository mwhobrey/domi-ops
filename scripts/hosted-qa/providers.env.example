# Copy to .qa/hosted/providers.env (ignored). Create a separate Google Testing project.
# Registered origin: http://localhost:13180 (adjust if DOMI_QA_BASE_PORT changed).
# Register all three /auth/... callbacks from docs/GOOGLE_OAUTH_SETUP.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=

# Optional Stripe sandbox. Leave ALL blank to retain the local Stripe simulator.
# Forward sandbox webhooks using Stripe CLI to localhost:13180/api/billing/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
