# Hosted Starter production (DEPLOYMENT_MODE=shared) — split infrastructure.
# Pair with docker-compose.hosted-prod.yml (+ docker-compose.marketing.yml for apps/www).
# Full walkthrough: deploy/HOSTED_BETA_SETUP.md
#
#   cp .env.hosted-prod.example .env
# Fill in every <...> placeholder below, then:
#   docker compose -f docker-compose.hosted-prod.yml -f docker-compose.marketing.yml up -d --build

# --- Core ---
NODE_ENV=production
PUBLIC_APP_URL=https://app.domi-ops.com
PUBLIC_MARKETING_URL=https://domi-ops.com
# Only needed if running the demo profile (docker-compose.marketing.yml --profile demo) — the
# demo site shares this same api container but has its own public origin, so Better Auth's
# trustedOrigins needs it listed explicitly or sign-in fails with "Invalid origin".
EXTRA_TRUSTED_ORIGINS=https://demo.domi-ops.com
AUTH_REQUIRED=true
ALLOW_PUBLIC_SIGNUP=false
# DEPLOYMENT_MODE and HOSTED_TIER are baked into docker-compose.hosted-prod.yml — do not override here.

SESSION_SECRET=<generate — openssl rand -base64 48 | tr -d '\n'>
ENCRYPTION_KEY=<generate — openssl rand -base64 32 | tr -d '\n'>

# --- Database (DigitalOcean Managed Postgres — NOT a container in this stack) ---
# Connection string from DO control panel → your cluster → Connection Details → "Connection string".
# Use the pooled (PgBouncer) connection string if DO offers one for your plan.
DATABASE_URL=postgresql://<db-user>:<db-password>@<do-postgres-host>:25060/domi_ops?sslmode=require

# --- Redis (containerized on this droplet — ephemeral, see deploy/HOSTED_OPS.md) ---
# REDIS_URL is set in docker-compose.hosted-prod.yml — do not override here.

# --- Object storage (DigitalOcean Spaces — NOT a container in this stack) ---
# S3_ENDPOINT is the origin API endpoint (presign/PUT/GET calls) — NOT the CDN endpoint below,
# CDN is edge-cache read-only, not an S3 API surface.
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_REGION=nyc3
S3_ACCESS_KEY=<Spaces access key>
S3_SECRET_KEY=<Spaces secret key>
S3_BUCKET=domi-ops-storage
S3_FORCE_PATH_STYLE=false   # Spaces uses virtual-hosted-style URLs
# CDN endpoint (enabled on the Space) — only actually used for the `school/` upload path today
# (apps/api/src/routes/school-upload.ts); Drive/avatars are proxied through the API regardless.
S3_PUBLIC_URL=https://domi-ops-storage.nyc3.cdn.digitaloceanspaces.com

# --- Google Calendar (optional — enable when ready for hosted users) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_DEFAULT_SYNC_MODE=import_only

# --- Modules (Starter entitles all; Stripe webhook sets modules_entitled per household) ---
# calendar_sync left out by default — packages/config requires GOOGLE_OAUTH_CLIENT_ID/SECRET
# above whenever it's listed here, so leaving it out matches the "optional, enable when
# ready" comment on the Google Calendar block. Add it back once those are filled in
# (confirmed live 2026-08-27 as a worker crash-loop when this contradicted itself).
MODULES_ENABLED=core,school,drive,health

# --- Drive quota (Starter tier default — 25 GB, docs/marketing/PRICING_TIERS.md) ---
DRIVE_DEFAULT_QUOTA_BYTES=26843545600
DRIVE_QUOTA_WARN_PERCENT=90
DRIVE_PUBLIC_SHARES_ENABLED=true

# --- Hosted billing (Stripe — LIVE keys) ---
# docs/marketing/STRIPE_SETUP.md for the dashboard checklist (product, price, coupon, webhook).
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...

# --- Web Push (optional) ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@domi-ops.com

# --- Marketing site flags (read by docker-compose.marketing.yml — same .env file) ---
# Flip both to "true" only once this file's Stripe keys are live and the stack is smoke-tested
# (deploy/HOSTED_BETA_SETUP.md §7). Self-host links stay "Coming soon" until WHO-174 separately.
NEXT_PUBLIC_HOSTED_CHECKOUT_ENABLED=false
NEXT_PUBLIC_OSS_REPO_PUBLIC=false
