    "@domi-ops/db": "*",
    "better-auth": "^1.6.14",
    "drizzle-orm": "^0.45.3",
    "nodemailer": "^10.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^5.8.3"
  }
