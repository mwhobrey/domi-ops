{
  "name": "@domi-ops/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp-client-provisioning": {
      "types": "./dist/mcp-client-provisioning.d.ts",
      "import": "./dist/mcp-client-provisioning.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "bootstrap:owner": "node dist/bootstrap-owner-cli.js",
    "user:cleanup": "node dist/cleanup-user-cli.js",
    "mcp:client": "node dist/mcp-client-cli.js"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.12",
    "@better-auth/core": "1.7.12",
    "@better-auth/oauth-provider": "1.7.12",
    "@domi-ops/config": "*",
    "@domi-ops/crypto": "*",
    "@domi-ops/db": "*",
    "better-auth": "1.7.12",
    "better-call": "1.4.4",
    "drizzle-orm": "^0.45.4",
    "nodemailer": "^10.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.8.3"
  }
}
