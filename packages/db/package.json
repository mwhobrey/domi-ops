{
  "name": "@domi-ops/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "migrate:run": "node dist/migrate.js",
    "seed:demo": "node dist/seed-demo.js",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@domi-ops/config": "*",
    "@domi-ops/crypto": "*",
    "better-auth": "^1.6.14",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "drizzle-kit": "^0.31.1",
    "typescript": "^5.8.3"
  }
}
