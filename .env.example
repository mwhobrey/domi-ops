# --- Core ---
NODE_ENV=development
# Default local dev: native turbo (web :3000). See .env.docker.example for compose web on :3001.
WHOME_DEV_PROFILE=native
PORT=3000
# PUBLIC_APP_URL must match the origin in your browser (OAuth redirect URIs derive from this).
PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Production: refuse to boot without auth (see packages/config)
AUTH_REQUIRED=true
SESSION_SECRET=change-me-min-32-chars-for-production
ENCRYPTION_KEY=change-me-32-byte-base64-or-hex-for-oauth-tokens

# --- Database ---
DATABASE_URL=postgresql://whome:whome@localhost:5432/whome

# Tenant isolation mode for THIS deployment:
# single = self-host (one household in one DB)
# shared = hosted entry tier (RLS)
# dedicated = this instance serves one household on its own DB URL
DEPLOYMENT_MODE=single

# --- Redis (worker / rate limits) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible; MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=whome
S3_SECRET_KEY=whome-dev-secret
S3_BUCKET=whome
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/whome

# --- Google Calendar (v1: import + optional bidirectional) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional override; default is PUBLIC_APP_URL + /auth/google/calendar/callback
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/auth/google/calendar/callback
# Google Cloud → Credentials → add BOTH redirect URIs under PUBLIC_APP_URL (see docs/GOOGLE_OAUTH_SETUP.md):
#   {PUBLIC_APP_URL}/auth/google/login/callback
#   {PUBLIC_APP_URL}/auth/google/calendar/callback
# Default for new connections: import_only | manual | bidirectional
GOOGLE_CALENDAR_DEFAULT_SYNC_MODE=import_only

# --- Dashboard weather (optional server default; users normally pick location in the app) ---
# Open-Meteo, no API key. Per-device location is saved in the browser (PWA / geolocation / city search).
# WEATHER_LATITUDE=41.88
# WEATHER_LONGITUDE=-87.63
# WEATHER_LOCATION_LABEL=Chicago

# --- Web Push (optional — household notice notifications) ---
# Generate: npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: URL (contact for the push sender)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- Modules (comma-separated enabled modules) ---
MODULES_ENABLED=core,school,calendar_sync

# After HomeHub import: map legacy display names to Google emails (optional)
# Deprecated — members join the imported household on Google login; set nicknames in Profile.
# HOUSEHOLD_MEMBER_EMAIL_MAP=

# --- Hosted product flags (ignored for self-host) ---
# HOSTED_TIER=starter|family|family_school|dedicated
