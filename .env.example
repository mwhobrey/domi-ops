# --- Core ---
NODE_ENV=development
# Default local dev: native turbo (web :3000, www :3002). See .env.docker.example for compose web on :3001.
DOMI_OPS_DEV_PROFILE=native
# Do NOT set PORT here — both Next.js (web) and the API read process.env.PORT for their own
# port (web defaults to 3000, API defaults to 4000 via apps/api/src/index.ts); a shared PORT
# value makes them collide and the API crash-loops on EADDRINUSE under `npm run dev`, which
# starts both at once. Leave unset; each defaults correctly on its own.
# PUBLIC_APP_URL must match the origin in your browser (OAuth redirect URIs derive from this).
PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Production: refuse to boot without auth (see packages/config)
AUTH_REQUIRED=true
# Public email/password owner sign-up (default: on in development, off in production).
# Dogfood/prod: leave unset or false — owners join via import + Google claim.
# ALLOW_PUBLIC_SIGNUP=false
# Greenfield self-host: one-time owner bootstrap at /setup (min 16 chars). Remove or rotate after first household exists.
# SETUP_TOKEN=generate-a-long-random-secret-here
# Better Auth signing secret (min 32 chars)
SESSION_SECRET=change-me-min-32-chars-for-production
ENCRYPTION_KEY=change-me-32-byte-base64-or-hex-for-oauth-tokens

# --- Database ---
# Required for live HomeHub import and app runtime; not needed for `import:homehub --dry-run`.
# Production Docker Compose: set POSTGRES_PASSWORD (compose builds DATABASE_URL for containers).
# POSTGRES_PASSWORD=
DATABASE_URL=postgresql://domi_ops:domi_ops@localhost:5432/domi_ops

# Tenant isolation mode for THIS deployment:
# single = self-host (one household in one DB)
# shared = hosted entry tier (RLS)
# dedicated = this instance serves one household on its own DB URL
DEPLOYMENT_MODE=single

# --- Redis (worker / rate limits) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible; MinIO in Docker prod/dev) ---
# In production Docker, compose runs MinIO — set S3_ACCESS_KEY / S3_SECRET_KEY (MinIO root user/password).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=domi_ops
S3_SECRET_KEY=domi-ops-dev-secret
S3_BUCKET=domi-ops
S3_FORCE_PATH_STYLE=true
# Browser upload/download base (bucket root). Prod behind Caddy: https://your.domain/s3/domi-ops
S3_PUBLIC_URL=http://localhost:9000/domi-ops
# Optional presign API origin override (default: derived from S3_PUBLIC_URL)
# S3_PUBLIC_ENDPOINT=https://your.domain/s3

# --- Google Calendar (v1: import + optional bidirectional) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Browser Google Picker (restrict to app origins in GCP — see docs/GOOGLE_OAUTH_SETUP.md)
# GOOGLE_PICKER_API_KEY=
# Optional GCP project number for Picker setAppId (digits). Derived from client id if unset.
# GOOGLE_CLOUD_PROJECT_NUMBER=
# Optional override; default is PUBLIC_APP_URL + /auth/google/calendar/callback
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/auth/google/calendar/callback
# Google Cloud → Credentials → add BOTH redirect URIs under PUBLIC_APP_URL (see docs/GOOGLE_OAUTH_SETUP.md):
#   {PUBLIC_APP_URL}/auth/callback/google
#   {PUBLIC_APP_URL}/auth/google/calendar/callback
# Default for new connections: import_only | manual | bidirectional
GOOGLE_CALENDAR_DEFAULT_SYNC_MODE=import_only

# --- Dashboard weather (optional server default; users normally pick location in the app) ---
# Open-Meteo, no API key. Per-device location is saved in the browser (PWA / geolocation / city search).
# WEATHER_LATITUDE=41.88
# WEATHER_LONGITUDE=-87.63
# WEATHER_LOCATION_LABEL=Chicago

# --- Web Push (optional — household notice notifications) ---
# Generate: npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: URL (contact for the push sender)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- Modules (comma-separated enabled modules) ---
MODULES_ENABLED=core,school,calendar_sync,drive,health

# --- Household Drive ---
# Per-file upload cap (bytes). Default 10 MB.
# DRIVE_UPLOAD_MAX_BYTES=10485760
# Hard-block uploads when storage_used_bytes >= storage_quota_bytes.
# DRIVE_QUOTA_ENFORCE=false
# Default quota for new households (bytes). 10737418240 = 10 GB. null/0 = unlimited.
# DRIVE_DEFAULT_QUOTA_BYTES=10737418240
# Warn threshold for settings storage meter (percent).
# DRIVE_QUOTA_WARN_PERCENT=90
# Public share links via GET /s/:token (set false to disable on self-host).
# DRIVE_PUBLIC_SHARES_ENABLED=true

# Deprecated — prefer HomeHub config.yml import (auth.display_names). Fallback only:
# HOUSEHOLD_MEMBER_EMAIL_MAP=

# Email verification (Better Auth email/password sign-up)
# EMAIL_VERIFICATION_REQUIRED=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# Error monitoring (Sentry) — optional, no-op if unset.
# SENTRY_DSN=

# --- Demo playground (marketing / demo.domi-ops.com — optional for local dev) ---
# DEMO_MODE=true
# DEMO_HOUSEHOLD_SLUG=rivera-demo
# DEMO_OWNER_EMAIL=demo@domi-ops.com
# DEMO_OWNER_PASSWORD=DemoRivera2026!
# DEMO_RESET_ENABLED=true

# --- Hosted product flags (ignored for self-host) ---
# HOSTED_TIER=starter|family|family_school|dedicated

# --- Opt-in anonymized metrics (docs/TELEMETRY.md) ---
# Off unless a household turns it on in Settings → Privacy — this var only controls WHERE
# collected metrics go, never whether they're collected. Same default works for both
# self-host and hosted (the central collector). Only change this if you're running your
# own collector or want to point self-host telemetry somewhere else entirely.
# TELEMETRY_ENDPOINT=https://app.domi-ops.com/api/telemetry

# --- Hosted billing (Stripe) — required when DEPLOYMENT_MODE=shared in production ---
# Create a "Domi Ops Cloud" Product in Stripe with two Prices, then paste IDs below.
# Use test-mode keys (sk_test_…) on staging; live keys (sk_live_…) on production.
# See docs/marketing/STRIPE_SETUP.md for full checklist.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_STARTER_MONTHLY=price_
# STRIPE_PRICE_STARTER_ANNUAL=price_
