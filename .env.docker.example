# Copy to .env when running the full stack with `docker compose up` (web on host :3001).
# Do not use with native `npm run dev` on :3000 — pick one dev path.

NODE_ENV=development
DOMI_OPS_DEV_PROFILE=docker
PUBLIC_APP_URL=http://localhost:3001
API_URL=http://localhost:4000

AUTH_REQUIRED=true
SESSION_SECRET=change-me-min-32-chars-for-production
ENCRYPTION_KEY=change-me-32-byte-base64-or-hex-for-oauth-tokens

DATABASE_URL=postgresql://domi_ops:domi_ops@localhost:5432/domi_ops
DEPLOYMENT_MODE=single
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=whome
S3_SECRET_KEY=domi-ops-dev-secret
S3_BUCKET=whome
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/whome

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Cloud → add BOTH (see docs/GOOGLE_OAUTH_SETUP.md):
#   http://localhost:3001/auth/google/login/callback
#   http://localhost:3001/auth/google/calendar/callback

GOOGLE_CALENDAR_DEFAULT_SYNC_MODE=import_only
MODULES_ENABLED=core,school,calendar_sync,drive
