{
  "name": "domi-ops",
  "version": "0.11.3",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:www": "npm run dev -w @domi-ops/www",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run generate -w @domi-ops/db",
    "db:migrate": "npm run build -w @domi-ops/db && npm run migrate:run -w @domi-ops/db",
    "dev:reset": "node scripts/dev-reset.mjs",
    "db:seed-demo": "npm run build -w @domi-ops/db && npm run seed:demo -w @domi-ops/db",
    "db:seed-hosted-qa": "npm run build -w @domi-ops/db && npm run seed:hosted-qa -w @domi-ops/db",
    "db:create-app-role": "node packages/db/scripts/create-hosted-app-role.mjs",
    "dev:hosted": "docker compose -f docker-compose.yml -f docker-compose.hosted.yml up -d postgres redis minio",
    "test:hosted": "vitest run --config vitest.hosted.config.ts",
    "bootstrap:owner": "npm run build -w @domi-ops/auth && npm run bootstrap:owner -w @domi-ops/auth",
    "user:cleanup": "npm run build -w @domi-ops/auth && npm run user:cleanup -w @domi-ops/auth --",
    "marketing:capture-screenshots": "node scripts/capture-demo-screenshots.mjs",
    "db:studio": "npm run studio -w @domi-ops/db",
    "import:homehub": "node packages/import-homehub/dist/cli.js",
    "import:validate": "npm run build -w @domi-ops/import-homehub && node packages/import-homehub/scripts/validate-import.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixture:homehub": "node packages/import-homehub/scripts/create-fixture.mjs",
    "qa:hosted": "node scripts/hosted-qa/run.mjs run",
    "qa:hosted:up": "node scripts/hosted-qa/run.mjs up",
    "qa:hosted:test": "node scripts/hosted-qa/run.mjs test",
    "qa:hosted:status": "node scripts/hosted-qa/run.mjs status",
    "qa:hosted:logs": "node scripts/hosted-qa/run.mjs logs",
    "qa:hosted:down": "node scripts/hosted-qa/run.mjs down",
    "qa:hosted:reset": "node scripts/hosted-qa/run.mjs reset",
    "qa:hosted:providers": "node scripts/hosted-qa/run.mjs providers"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "node-gyp": "^13.1.0",
    "playwright": "^1.64.0",
    "turbo": "^2.11.10",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.1",
    "prisma": "^7.0.0"
  }
}
