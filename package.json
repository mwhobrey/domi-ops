{
  "name": "whome",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run generate -w @whome/db",
    "db:migrate": "npm run build -w @whome/db && npm run migrate:run -w @whome/db",
    "dev:reset": "node scripts/dev-reset.mjs",
    "db:seed-demo": "npm run build -w @whome/db && npm run seed:demo -w @whome/db",
    "marketing:capture-screenshots": "node scripts/capture-demo-screenshots.mjs",
    "db:studio": "npm run studio -w @whome/db",
    "import:homehub": "node packages/import-homehub/dist/cli.js",
    "import:validate": "npm run build -w @whome/import-homehub && node packages/import-homehub/scripts/validate-import.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixture:homehub": "node packages/import-homehub/scripts/create-fixture.mjs"
  },
  "devDependencies": {
    "playwright": "^1.51.1",
    "node-gyp": "^11.5.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "drizzle-orm": "^0.45.2"
  }
}
